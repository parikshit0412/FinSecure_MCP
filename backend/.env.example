# FinSecure-MCP Environment Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
# If left empty, the Gateway operates in educational simulation mode with forensic reasoning.
GEMINI_API_KEY=

# Database Connection URL (PostgreSQL)
# When Docker container is active: postgresql://postgres:postgrespassword@localhost:5432/finsecure_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/finsecure_db

# Set to true to force SQLite mode even if PostgreSQL is accessible
USE_SQLITE=false
